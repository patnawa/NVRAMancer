/* Resource script for AsprogrammerPN
 *
 * Rebuild AsprogrammerPN.res after changing the icon or the version:
 *   windres -i AsprogrammerPN.rc -o AsprogrammerPN.res -O res
 *
 * lazbuild does not regenerate the .res, only the Lazarus IDE does, so the
 * file is compiled by hand and committed.
 */

MAINICON ICON "AsprogrammerPN.ico"

/* RT_MANIFEST, so Windows uses themed controls and treats the app as
   DPI aware, both of which the project options ask for */
1 24 "AsprogrammerPN.manifest"

/* No VERSIONINFO here on purpose: lazbuild builds its own from the
   VersionInfo block in AsprogrammerPN.lpi, and two of them would collide. */
