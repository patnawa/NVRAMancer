# Lazarus / FPC build output
software/lib/
software/backup/
*.exe
*.compiled
*.or
*.ppu
*.o
*.a
__pycache__/
*.pyc

# PE sections someone unpacked out of a built AsProgrammer.exe and committed.
# .text is the compiled code, .idata the import table, .rsrc the form and icon
# resources -- all of it regenerated by every build, and none of it source.
software/.text
software/.data
software/.bss
software/.idata
software/.rsrc/

# Vendor runtime DLLs.
#
# tools/build.ps1 downloads these from one pinned upstream archive and checks
# every byte against a recorded SHA-256 before packaging them, so a copy in the
# source tree is a second, unverified answer to a question that already has a
# verified one. vendor-manifest.json records where each comes from.
#
# software/libusb0.dll is deliberately NOT ignored: it is the signed
# libusb-win32 1.4.0.2 runtime the EZP transport needs, it is not in the
# upstream archive, and build.ps1 asserts its hash from the repository copy.
software/CH341DLL.DLL
software/CH347DLL.DLL
software/ftd2xx.dll
software/buzzpirathlp.dll
software/libiconv2.dll
software/libintl3.dll
software/buzzpirathlp/libiconv2.dll
software/buzzpirathlp/libintl3.dll
software/tail.exe
software/buzzpirathlp/tail.exe

# Third-party driver installers. These are redistributables, not source, and
# they were 24 MB of a 45 MB checkout -- including three versions of Zadig.
# vendor-manifest.json records what each one is and its SHA-256; fetch them
# from the vendor, or from a release asset, rather than from a source clone.
drivers/usbasp/zadig_*.exe
drivers/FT232/CDM212364_Setup.exe
drivers/CH34X/
# The extracted CH341PAR/ tree beside it is what the program actually reads.
drivers/CH347T-Driver/CH341PAR.ZIP

# Byte-identical to drivers/AVRISPMK2/, which is where the other driver
# bundles live. Ignored rather than deleted: an existing checkout keeps its
# copy, and a fresh clone simply never grows a second one.
firmware/AVRISP-MKII/WindowsDriver/

# Extracted from mphexeditor.zip during setup, not source
mphexeditor/

# Runtime copy of the chip list (source of truth is chiplist.xml in the repo root)
software/chiplist.xml

# Runtime state, written by the program next to the exe
software/settings.xml
chiplist-user.xml
software/chiplist-user.xml
backup/
software/backup/

# Production output: serial and traceability logs belong to the operator
*.csv
serials.log

# Release output
release/
hil-results/

# Local focused-test output (keep unrelated tmp/ material visible)
tmp/capabilities-*/
tmp/headless-*/
tmp/operationrunner-*/

# Third party binary kept locally for reference, deliberately not distributed.
# A Linux ELF with no source and no clear licence has no place in an MIT repo,
# and nothing here needs it: tools/import_ezp.py reads the same .Dat format and
# fixes the three bugs this has (ids printed with %hhx lose their leading zeros,
# GBK part names are not decoded, and it reads past the end of the file).
ezp_parser

# Chip dumps read off real hardware - may contain serials, keys or board config.
# Never publish these.
*.bin
!firmware/**/*.bin
ezpspy.log
