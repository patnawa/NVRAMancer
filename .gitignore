# Lazarus / FPC build output
software/lib/
software/backup/
*.exe
*.compiled
*.or
*.ppu
*.o
*.a
__pycache__/
*.pyc

# Extracted from mphexeditor.zip during setup, not source
mphexeditor/

# Runtime copy of the chip list (source of truth is chiplist.xml in the repo root)
software/chiplist.xml

# Runtime state, written by the program next to the exe
software/settings.xml
chiplist-user.xml
software/chiplist-user.xml
backup/
software/backup/

# Production output: serial and traceability logs belong to the operator
*.csv
serials.log

# Release output
release/
hil-results/

# Local focused-test output (keep unrelated tmp/ material visible)
tmp/capabilities-*/
tmp/headless-*/
tmp/operationrunner-*/

# Third party binary kept locally for reference, deliberately not distributed.
# A Linux ELF with no source and no clear licence has no place in an MIT repo,
# and nothing here needs it: tools/import_ezp.py reads the same .Dat format and
# fixes the three bugs this has (ids printed with %hhx lose their leading zeros,
# GBK part names are not decoded, and it reads past the end of the file).
ezp_parser

# Chip dumps read off real hardware - may contain serials, keys or board config.
# Never publish these.
*.bin
!firmware/**/*.bin
ezpspy.log
